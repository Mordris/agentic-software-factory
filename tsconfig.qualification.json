{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "skipLibCheck": false,
    "outDir": "dist/qualification",
    "rootDir": "evals/qualification"
  },
  "include": ["evals/qualification/**/*.ts"]
}
