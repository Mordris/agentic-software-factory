{
  "repository": "Mordris/agentic-software-factory",
  "description": "Building an experimental agentic software factory with one Headquarters, specialized labs, live tracing, and human-approved delivery.",
  "topics": [
    "agentic-ai",
    "software-development",
    "multi-agent",
    "claude-code",
    "typescript",
    "react",
    "developer-tools",
    "observability",
    "workflow-automation",
    "open-source"
  ],
  "settings": {
    "has_issues": true,
    "has_wiki": false,
    "has_projects": false,
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "allow_auto_merge": false,
    "delete_branch_on_merge": true,
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "PR_BODY"
  },
  "security": {
    "private_vulnerability_reporting": true,
    "dependabot_alerts": true,
    "automatic_security_fix_pull_requests": false,
    "secret_scanning": true,
    "secret_scanning_push_protection": true
  },
  "actions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false,
    "require_sha_pinning": true,
    "allowed_actions": "selected",
    "github_owned_allowed": true,
    "verified_allowed": false,
    "fork_pr_approval": "all_external_contributors"
  }
}
